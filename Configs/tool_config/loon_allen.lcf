[Remote Filter]
# 根据节点名称筛选地区，并排除回国、校园和游戏节点。
All Server = NameRegex, FilterKey = "^(?=.*(.*))(?!.*((?i)邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|到期|过期|已用|联系|邮箱|工单|群|贩卖|倒卖|防止|国内|🎮|(\b(GAME|USE|USED|TOTAL|EXPIRE|EMAIL|Panel)\b|(\d{4}-\d{2}-\d{2}|\dG)))).*$"
RFC = NameRegex, FilterKey = "RFC"
家宽 = NameRegex, FilterKey = "(?i)(家宽|verizon$)"
日本优选筛选 = NameRegex, FilterKey = "^(?=.*((?i)🇯🇵|日本|川日|东京|大阪|泉日|埼玉|(\b(JP|JPN|Japan)(\d+)?\b)))(?!.*((?i)家宽|verizon$|回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
美国优选筛选 = NameRegex, FilterKey = "^(?=.*((?i)🇺🇸|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|(\b(US|USA|United States)(\d+)?\b)))(?!.*((?i)家宽|verizon$|回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
香港 = NameRegex, FilterKey = "^(?=.*((?i)🇭🇰|香港|(\b(HK|HKG|Hong)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
台湾 = NameRegex, FilterKey = "^(?=.*((?i)🇹🇼|台湾|(\b(TW|TWN|Tai|Taiwan)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
日本 = NameRegex, FilterKey = "^(?=.*((?i)🇯🇵|日本|川日|东京|大阪|泉日|埼玉|(\b(JP|JPN|Japan)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
美国 = NameRegex, FilterKey = "^(?=.*((?i)🇺🇸|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|(\b(US|USA|United States)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
新加坡 = NameRegex, FilterKey = "^(?=.*((?i)🇸🇬|新加坡|狮城|(\b(SG|SGP|Singapore)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
德国 = NameRegex, FilterKey = "^(?=.*((?i)🇩🇪|德国|德國|法兰克福|法蘭克福|柏林|慕尼黑|(\b(DE|DEU|Germany|Deutschland|Frankfurt|Berlin|Munich)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
其他 = NameRegex, FilterKey = "(?i)^(?!.*(家宽|verizon$|🇭🇰|香港|(^|[^A-Za-z0-9])(HK|HKG|Hong([ _-]?Kong)?)([ _-]?\d+)?($|[^A-Za-z0-9])|🇹🇼|台湾|台北|(^|[^A-Za-z0-9])(TW|TWN|Tai|Taiwan)([ _-]?\d+)?($|[^A-Za-z0-9])|🇯🇵|日本|川日|东京|大阪|泉日|沪日|深日|埼玉|(^|[^A-Za-z0-9])(JP|JPN|Japan)([ _-]?\d+)?($|[^A-Za-z0-9])|🇸🇬|新加坡|狮城|(^|[^A-Za-z0-9])(SG|SGP|Singapore)([ _-]?\d+)?($|[^A-Za-z0-9])|🇺🇸|🇺🇲|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|(^|[^A-Za-z0-9])(US|USA|United[ _-]?States|States)([ _-]?\d+)?($|[^A-Za-z0-9])|🇩🇪|德国|德國|法兰克福|法蘭克福|柏林|慕尼黑|(^|[^A-Za-z0-9])(DE|DEU|Germany|Deutschland|Frankfurt|Berlin|Munich)([ _-]?\d+)?($|[^A-Za-z0-9])|直连|回国|校园|游戏|🎮|邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|交流群|官方群|用户群|群组|社群|群聊|贩卖|倒卖|防止|国内|(^|[^A-Za-z0-9])(GAME|USE|USED|TOTAL|EXPIRE|EMAIL|Panel)($|[^A-Za-z0-9])|\d{4}-\d{2}-\d{2})).+$"

[Rule]
# 本地兼容放行优先；远程业务之间的顺序在 Remote Rule 中维护。
DOMAIN,dns.alidns.com,DIRECT
DOMAIN-SUFFIX,push.apple.com,DIRECT
DOMAIN,wetype.weixin.qq.com,DIRECT
# 按顺序匹配：主动覆盖 → 兼容放行 → 基础拦截 → 国内媒体/直连 → 境外业务 → 通用分流 → IP/FINAL。

# === 1. 用户主动覆盖 ===
# 这些覆盖是用户主动设置：保留先于地区和个人站点规则的优先级。
DOMAIN-SUFFIX,052909.xyz,美国节点
DOMAIN-SUFFIX,mfallen.de,美国节点
DOMAIN-SUFFIX,api.flyapi.tech,美国节点
DOMAIN-SUFFIX,nodeseek.com,日本节点
DOMAIN,rfc.uhdnow.com,RFC节点
# YouTube 图片与视频使用同一业务组，优先于地区 us.list 中的 ggpht.com。
DOMAIN-SUFFIX,ggpht.com,YouTube
DOMAIN-SUFFIX,ytimg.com,YouTube

# === 2. 国内 App 兼容放行 ===
# 精确放行常见国内调度/解析端点；不对整个国内域名或全部云厂商做提前放行。
DOMAIN-SUFFIX,amdc.m.taobao.com,DIRECT
DOMAIN-SUFFIX,amdcopen.m.taobao.com,DIRECT
DOMAIN,httpdns.alicdn.com,DIRECT
DOMAIN-SUFFIX,httpdns.aliyuncs.com,DIRECT
DOMAIN,httpdns-sc.aliyuncs.com,DIRECT
DOMAIN,httpdns-api.aliyuncs.com,DIRECT
DOMAIN,httpdns.danuoyi.tbcache.com,DIRECT
IP-CIDR,203.107.1.0/24,DIRECT,no-resolve
# B 站、美团、网易、百度和字节服务的 HTTPDNS。
DOMAIN,httpdns.bilivideo.com,DIRECT
DOMAIN,httpdns.meituan.com,DIRECT
DOMAIN,httpdnsvip.meituan.com,DIRECT
DOMAIN,httpdnsmultiapi.meituan.com,DIRECT
DOMAIN,httpdnsmultiapivip.meituan.com,DIRECT
DOMAIN-SUFFIX,httpdns.c.163.com,DIRECT
DOMAIN,httpdns.music.163.com,DIRECT
DOMAIN-SUFFIX,httpdns.n.netease.com,DIRECT
DOMAIN,httpdns.baidu.com,DIRECT
DOMAIN,httpdns.baidubce.com,DIRECT
DOMAIN,httpsdns.baidu.com,DIRECT
DOMAIN,httpdns.volces.com,DIRECT
DOMAIN,httpdns.volcengineapi.com,DIRECT
DOMAIN,dns.jd.com,DIRECT
DOMAIN,dns.weibo.cn,DIRECT
DOMAIN,dns.weixin.qq.com,DIRECT
DOMAIN,dns.weixin.qq.com.cn,DIRECT

# === 3. 本地网络、地区与固定直连 ===
# 中国电信业务保持在拦截之前。
# 校时使用直连，避免被 AI/CDN 规则决定出口。
DOMAIN-SUFFIX,pool.ntp.org,DIRECT

# === 4. Apple 通知与 iCloud 例外 ===
# Private Relay 必须先于 iCloud 全域直连。
DOMAIN,mask.icloud.com,Apple
DOMAIN,mask-h2.icloud.com,Apple
DOMAIN,mask-api.icloud.com,Apple
DOMAIN,mask-canary.icloud.com,Apple
DOMAIN,mask.apple-dns.net,Apple
DOMAIN,canary.mask.apple-dns.net,Apple
DOMAIN-SUFFIX,apple-dns.net,DIRECT
DOMAIN-SUFFIX,apple-relay.apple.com,Apple

# === 5. 基础去广告与 PCDN ===
# 基础广告统一使用普通拒绝；必要 HTTPDNS 已在前面放行。
# PCDN 拦截独立保留，使用明确拒绝以减少长时间等待。
# SDK 静默丢弃、独立 IP 拦截默认关闭；需要时再单独评估。
# 用户原有的手动拦截；lcs-cops 精确放行优先于 adobe.io。
DOMAIN,lcs-cops.adobe.io,DIRECT
DOMAIN-SUFFIX,hstatic.io,REJECT
DOMAIN-SUFFIX,adobestats.io,REJECT
DOMAIN-SUFFIX,adobe.io,REJECT
DOMAIN,ntb.lanjie100.com,REJECT
DOMAIN,msmp.abchina.com.cn,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

# === 6. 国内媒体与通用直连 ===
# 两个国内媒体业务组先匹配，组内仍默认 DIRECT；需要时可手动切换。
# 国内常用域名统一由 domestic 维护；广告规则仍优先，HTTPDNS 走第 2 区精确例外。

# === 7. 境外业务与系统服务 ===
# 国内通用直连已先匹配：保留国内游戏下载 CDN、国内支付等原有直连。
# 测速点先于 Netflix 等业务规则，保留 fast.com 的测速入口。
# 国内 CDN 和 Apple CN 保持直连；位于广告之后、Apple/Microsoft 通用业务之前。
# Gemini 保持使用 Google；ChatGPT、Claude、NotebookLM 等继续使用 AI。
DOMAIN-SUFFIX,safebrowsing.google.com,Google
# GitHub API 保留明确归属；Copilot 的独立端点由 AI 规则处理。
DOMAIN-SUFFIX,github.io,GitHub
DOMAIN-SUFFIX,githubassets.com,GitHub
DOMAIN,api.github.com,GitHub
# 自有 AI + SKK 作为主体；补齐原 AIGC 中少量专属端点。
DOMAIN-SUFFIX,cursor.com,AI
DOMAIN-SUFFIX,claudeusercontent.com,AI
DOMAIN-SUFFIX,chatgpt.livekit.cloud,AI
DOMAIN-SUFFIX,aicode.googleapis.com,AI

# === 8. 通用流媒体、购物、CDN 与境外兜底 ===
# Amazon 共用图片域名按购物处理；视频接口仍优先进入流媒体组。
DOMAIN-SUFFIX,media-amazon.com,海淘
# 仅保留一份通用流媒体总集；Prime Video 端点先于 amazon.com 购物后缀。
# Amazon/eBay 商品图必须先于通用 CDN。

# === 9. IP 与最终兜底 ===
# IP 规则在业务域名之后；Telegram ASN/IP 覆盖原样保留。
# 本机 DNS 已解析到内网或中国大陆时直连；DNS 失败继续交给 Final。
DOMAIN-SUFFIX,local,DIRECT
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
GEOIP,CN,DIRECT
FINAL,Final

